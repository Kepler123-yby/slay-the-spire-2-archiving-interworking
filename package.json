{
  "name": "spire-save-bridge",
  "version": "0.1.2",
  "private": true,
  "description": "Slay the Spire 2 Quark save bridge — Mac validation build",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:quark": "node scripts/setup-quark.mjs",
    "probe:cloud": "node scripts/cloud-probe.mjs",
    "pack:mac": "node scripts/pack.mjs darwin",
    "pack:windows": "node scripts/pack.mjs win32",
    "probe:roundtrip": "node scripts/roundtrip-probe.mjs",
    "test:ui": "electron scripts/ui-flow-test.cjs",
    "agent:check": "node .runtime/quark/scripts/quark-drive.cjs resolve-agent"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^42.0.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
